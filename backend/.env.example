# ---- Server ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---- Database (transactions REQUIRE a replica set; Atlas has one by default) ----
# Local single-node replica set: mongod --replSet rs0 ...  then run rs.initiate() once in mongosh
MONGO_URI=mongodb://127.0.0.1:27017/irctc_clone?replicaSet=rs0

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ---- Web ----
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# ---- Booking rules ----
HOLD_MINUTES=10
HOLD_SWEEP_SECONDS=30
MAX_ACTIVE_HOLDS=3
BOOKING_CUTOFF_MINUTES=30
MAX_ADVANCE_DAYS=120
GST_PERCENT=5
# hoursBeforeDeparture:refundPercent  (largest first; below the smallest tier = 0% refund)
REFUND_TIERS=48:90,12:75,4:50

# ---- Mock payments ----
# true  = the client reports the simulated gateway outcome (demo/testing)
# false = outcome is simulated on the server using MOCK_PAYMENT_FAILURE_RATE
MOCK_PAYMENT_ALLOW_CLIENT_OUTCOME=true
MOCK_PAYMENT_FAILURE_RATE=0.1

# ---- Misc ----
RATE_LIMIT_DISABLED=false
RUN_HOLD_SWEEPER=true

# ---- Seed script only (never commit real values) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-this-demo-password

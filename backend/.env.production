# ---- Server ----
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ---- Database (will be set in Render dashboard) ----
# MONGO_URI will be provided by Render environment variable

# ---- Auth ----
JWT_SECRET=48d9aaaa40d7a9489dcbffa13bc962efa399405fe6126cd25a2925b4d03943d478657ab605364273ee69a80c0d6422c6
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ---- Web ----
CORS_ORIGIN=*
APP_BASE_URL=https://irctc-clone.vercel.app

# ---- Booking rules ----
HOLD_MINUTES=10
HOLD_SWEEP_SECONDS=30
MAX_ACTIVE_HOLDS=3
BOOKING_CUTOFF_MINUTES=30
MAX_ADVANCE_DAYS=120
GST_PERCENT=5
REFUND_TIERS=48:90,12:75,4:50

# ---- Mock payments ----
MOCK_PAYMENT_ALLOW_CLIENT_OUTCOME=true
MOCK_PAYMENT_FAILURE_RATE=0.1

# ---- Misc ----
RATE_LIMIT_DISABLED=false
RUN_HOLD_SWEEPER=true

# ---- Seed script only ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-this-demo-password

            },
            "url": {
              "raw": "{{baseUrl}}/payments/mock-confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "mock-confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }

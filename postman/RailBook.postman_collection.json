    {
      "name": "3. Booking flow",
      "item": [
        {
          "name": "Create booking (hold seats)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.expect(j.data.booking.status).to.eql('PENDING_PAYMENT'); pm.collectionVariables.set('bookingId', j.data.booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": \"{{scheduleId}}\",\n  \"from\": \"NDLS\",\n  \"to\": \"HWH\",\n  \"date\": \"{{date}}\",\n  \"classCode\": \"3A\",\n  \"passengers\": [\n    {\n      \"name\": \"Asha Rao\",\n      \"age\": 34,\n      \"gender\": \"F\"\n    },\n    {\n      \"name\": \"Ravi Rao\",\n      \"age\": 36,\n      \"gender\": \"M\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Initiate payment",

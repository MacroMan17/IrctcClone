                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.expect(j.data.count).to.be.above(0);",
                  "const t = j.data.trains[0]; pm.collectionVariables.set('scheduleId', t.scheduleId); pm.collectionVariables.set('trainId', t.trainId);"
                ]
              }
